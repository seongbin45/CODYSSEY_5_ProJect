# 이 파일을 복사해 .env 를 만듭니다.
#   copy .env.example .env
# = 오른쪽에만 키를 붙입니다. 따옴표와 KakaoAK 는 넣지 않습니다.
# .env 는 GitHub 에 올리지 않습니다.

# 필수 (없으면 프로그램이 종료됩니다)
GEMINI_API_KEY=
KAKAO_REST_API_KEY=

# 선택 (비워 두면 그 단계만 건너뜁니다)
TMAP_OPEN_API_APP_KEY=
TOUR_API_SERVICE_KEY=

# 아래는 fastapi-web / exe 전용입니다. 이 브랜치에서 python 으로 실행할 때는 비워 두세요.
# KEY_SERVER_TOKEN=
# KEY_SERVER_URL=https://codyssey-5-project.onrender.com/api/keys
